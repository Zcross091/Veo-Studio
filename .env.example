# Copy to ".env" and paste your keys. Never share or commit .env.

# ==========================================================
# CLOUD / DEVELOPER KEYS
# ==========================================================
# 1. GenRelay API key (for Google Veo 3.1 & Veo 3.1 FL):
GENRELAY_API=

# 2. Fal.ai API key (for MiniMax Video-01, Kling 1.0, Luma Dream Machine):
FAL.AI_API=

# 3. Google Gemini API key (for Scene Planning & Google Direct Omni):
GEMINI_API_KEY=

# ==========================================================
# FREE TIER PROVIDER CREDENTIALS
# ==========================================================
# 4. Kaggle Free GPU & Model Quota (30 hrs/wk GPU, 20 hrs/wk TPU, $100/mo AI Models: https://www.kaggle.com/settings/api)
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# 5. OpenArt AI (40 free monthly tokens - or run '.\.venv\Scripts\openart.exe login')
OPENART_TOKEN=

# 6. Hugging Face (Free ZeroGPU compute: https://huggingface.co/settings/tokens)
HF_TOKEN=

# 7. Kling AI (66 daily credits: https://klingai.com)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# 8. Luma Dream Machine (30 monthly free: https://lumalabs.ai)
LUMA_API_KEY=

# 9. Hailuo / MiniMax (Video-01 Free Allowance: https://api.minimax.chat)
MINIMAX_API_KEY=

# 10. Pollinations AI (Free API Tier: https://enter.pollinations.ai)
POLLINATIONS_KEY=

# 11. KIE AI (All Models Access - Kling, Hailuo, Runway, Veo, Flux: https://kie.ai/api-key)
KIE_API_KEY=

# Copy this file to ".env" and paste your key after the equals sign.
# Never share the .env file or commit it anywhere.
GEMINI_API_KEY=

# Optional: Default models
# Video generation models: gemini-omni-1.1-flash, gemini-omni-flash-preview, veo-2.0-generate-001, veo-3.1-generate-preview
DEFAULT_VIDEO_MODEL=gemini-omni-1.1-flash

# Scene planner models: gemini-3.8-flash, gemini-3.1-pro-preview, gemini-3.5-flash, gemini-4-argon, gemini-3.1-flash-lite
DEFAULT_PLANNER_MODEL=gemini-3.8-flash
